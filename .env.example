# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/*).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY & STRIPE_WEBHOOK_SECRET: Server-side Stripe billing & webhook keys (Test Mode default).
# Never expose secret keys in client-side VITE_ variables or browser inputs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# RESEND_API_KEY: Server-side transactional email key.
RESEND_API_KEY=""
